OPENAI_API_KEY=sk-...
TARGET_LANG=pl
SOURCE_LANG=
TRANSCRIBE_MODEL=gpt-4o-transcribe
TRANSLATION_MODEL=gpt-4o-mini
PORT=3000

# Daily listening caps - the only real protection against a public link
# accidentally running up a large OpenAI bill before there are real
# accounts/billing. Per anonymous device, and across everyone combined.
MAX_USER_MINUTES_PER_DAY=30
MAX_GLOBAL_MINUTES_PER_DAY=300
