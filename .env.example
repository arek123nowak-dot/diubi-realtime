OPENAI_API_KEY=sk-...
TARGET_LANG=pl
SOURCE_LANG=
TRANSCRIBE_MODEL=gpt-4o-transcribe
TRANSLATION_MODEL=gpt-4o-mini
PORT=3000

# Daily listening caps - the only real protection against a public link
# accidentally running up a large OpenAI bill before there are real
# accounts/billing. Per anonymous device, and across everyone combined.
# 30/300 is a reasonable public-facing default; raised here during the
# solo-testing phase, where one real tester burning through 30 min/day of
# live iteration is friction, not a cost risk worth guarding against yet.
MAX_USER_MINUTES_PER_DAY=240
MAX_GLOBAL_MINUTES_PER_DAY=480
