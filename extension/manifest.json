{
  "manifest_version": 3,
  "name": "DIUBI — tlumaczenie na zywo",
  "version": "0.1.0",
  "description": "Napisy na zywo z tlumaczeniem dla dowolnego audio odtwarzanego w karcie przegladarki.",
  "permissions": ["tabCapture", "offscreen", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DIUBI — start/stop napisow"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
