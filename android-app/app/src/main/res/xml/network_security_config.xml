<?xml version="1.0" encoding="utf-8"?>
<!-- Allows plain http:// during local development, when the WebView points
     at a dev machine's LAN IP (e.g. http://192.168.1.23:3000) instead of a
     deployed https:// server. Tighten this once DIUBI only ever points at
     a real https deployment. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
